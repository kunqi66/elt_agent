# =============================================================================
# elt_agent 环境变量 —— 唯一事实来源（SSOT）
# 用法：cp .env.example .env 然后逐项填写。.env 永不进仓库。
# 约定：分段字段（HOST/PORT/USER/PASSWORD/DB）为事实来源，派生 URL 由 settings 计算，
#       不要手写 *_URL，避免两处不一致。
# =============================================================================

# ---------- 运行环境 ----------
APP_NAME=elt_agent
APP_ENV=dev                        # dev | staging | prod（取值同领域枚举 Env，勿另立词汇）
APP_DEBUG=true
API_V1_PREFIX=/api/v1
# 生产环境（APP_ENV=prod）启动时强制自检：密钥非默认值、DEBUG=false、CORS 非通配
SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- 对外访问 ----------
# 暂用 IP:port，不申请域名不备案；Nginx 为唯一对外入口
HTTP_PORT=80
SERVER_HOST=60.205.138.167

# ---------- PostgreSQL（控制面库 + LangGraph Checkpoint）----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=elt
POSTGRES_PASSWORD=change-me-pg
POSTGRES_DB=elt_agent
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# ---------- Redis（Celery broker/result + 缓存 + Capability 消费标记）----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis
REDIS_DB_CACHE=0
REDIS_DB_BROKER=1
REDIS_DB_RESULT=2

# ---------- Celery ----------
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_TIME_LIMIT=7200
CELERY_TASK_SOFT_TIME_LIMIT=6900
OUTBOX_SCAN_INTERVAL_SEC=2
OUTBOX_MAX_ATTEMPTS=5

# ---------- MinIO / 对象存储（文件数据源 + 制品归档）----------
MINIO_ROOT_USER=elt-minio
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET=elt-artifacts

# ---------- HashiCorp Vault（SecretProvider）----------
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=change-me-vault-token
VAULT_KV_MOUNT=kv
VAULT_ROLE_ID=
VAULT_SECRET_ID=

# ---------- LLM Provider ----------
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-deepseek-key
LLM_MODEL_GENERATE=deepseek-chat
LLM_MODEL_DIAGNOSE=deepseek-reasoner
LLM_TIMEOUT_SEC=90
LLM_MAX_RETRY=2
LLM_PROMPT_TOKEN_BUDGET=8000
LLM_AUTOFIX_MAX_ROUNDS=3

# ---------- Capability 令牌（Ed25519）----------
# 生成：uv run python -m core.keys generate --out ./secrets/capability_signing_key.pem
CAPABILITY_SIGNING_KEY_PATH=/run/secrets/capability_signing_key.pem
CAPABILITY_KEY_ID=cap-2026-10
CAPABILITY_TTL_SEC=300
CAPABILITY_ISSUER=elt-agent
# 证据账本签名密钥（可与 Capability 分开，便于独立轮转）
LEDGER_SIGNING_KEY_PATH=/run/secrets/ledger_signing_key.pem
LEDGER_CHECKPOINT_INTERVAL=100

# ---------- 演示数据面（profile: demo）----------
# 源库
DEMO_MYSQL_HOST=mysql
DEMO_MYSQL_PORT=3306
DEMO_MYSQL_USER=etl_demo
DEMO_MYSQL_PASSWORD=change-me-demo
DEMO_MYSQL_DB=biz_demo
DEMO_MYSQL_ROOT_PASSWORD=change-me-root
# 目标库（Doris FE 查询端口 9030，HTTP 8030）
DEMO_DORIS_HOST=doris
DEMO_DORIS_PORT=9030
DEMO_DORIS_USER=root
DEMO_DORIS_PASSWORD=
DEMO_DORIS_DB=dw_demo
# SeaTunnel Zeta
SEATUNNEL_HOST=seatunnel
SEATUNNEL_API_PORT=8080
SEATUNNEL_WORK_DIR=/tmp/seatunnel-jobs
# 镜像名（可覆盖）。默认值指向第三方代理：这台 ECS 的 Docker Hub 加速器实测全部失效，
# 只有 docker.1panel.live 能拉到这两个镜像，且 Doris 的可用 tag 只有 `-all` 形态。
DORIS_IMAGE=docker.1panel.live/apache/doris:2.1.9-all
SEATUNNEL_IMAGE=docker.1panel.live/apache/seatunnel:2.3.9

# ---------- 运行监督默认预算（可被 Pipeline 级契约覆盖）----------
SUP_MAX_READ_ROWS=100000000
SUP_MAX_WRITE_BYTES=53687091200
SUP_MAX_DURATION_SEC=7200
SUP_MAX_AMPLIFICATION_RATIO=1.5
SUP_MAX_REJECT_RATE=0.05
SUP_WARN_THRESHOLD_PCT=80

# ---------- 可观测（profile: obs）----------
GRAFANA_ADMIN_PASSWORD=change-me-grafana
ALERT_DINGTALK_WEBHOOK=
ALERT_ENABLED=false

# ---------- 保留策略 ----------
RUN_LOG_RETENTION_DAYS=90
QUALITY_REPORT_RETENTION_DAYS=0   # 0 = 永久
EVIDENCE_RETENTION_DAYS=0         # 0 = 永久
