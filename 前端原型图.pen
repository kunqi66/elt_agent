                              "children": [
                                {
                                  "type": "text",
                                  "name": "代码",
                                  "content": "env {\n  job.mode = \"BATCH\"\n  parallelism = 2\n}\nsource {\n  Jdbc {\n    url = \"jdbc:mysql://10.0.1.21:3306/orders\"\n    password = \"${vault:secret/elt/mysql-orders-prod#password@v3}\"\n    query = \"SELECT id, user_id, user_phone, amount, updated_at\n             FROM orders WHERE updated_at >= '${watermark}'\"\n  }\n}\ntransform {\n  Sql { query = \"\"\"SELECT id, user_id, amount, updated_at,\n           sha2(concat(user_phone, '${salt}'), 256) AS user_phone_hash\n           FROM orders_source\"\"\" }\n}\nsink {\n  Doris {\n    fenodes = \"10.0.2.30:8030\"\n    table.identifier = \"dw.orders_wide_shadow\"\n    sink.enable-2pc = true\n  }\n}",
                                  "fontFamily": "$font-mono",
                                  "fontSize": 11,
                                  "fill": "$code-text",
                                  "lineHeight": 1.5,
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container"
                                }
                              ]
                            }
                          ]
                        }
