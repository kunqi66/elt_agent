    {
      "type": "frame",
      "name": "01 登录页",
      "width": 1440,
      "height": 900,
      "layout": "horizontal",
      "clip": true,
      "fill": "$bg-app",
      "x": 0,
      "y": 0,
      "children": [
        {
          "type": "frame",
          "name": "品牌面板",
          "layout": "vertical",
          "gap": 48,
          "width": 720,
          "padding": 64,
          "height": "fill_container",
          "justifyContent": "space_between",
          "alignItems": "start",
          "fill": {
            "type": "gradient",
            "gradientType": "linear",
            "rotation": 200,
            "colors": [
              {
                "color": "#152747",
                "position": 0
              },
              {
                "color": "#0B1220",
                "position": 1
              }
            ]
          },
          "children": [
            {
              "type": "frame",
              "name": "品牌行",
              "layout": "horizontal",
              "gap": 12,
              "alignItems": "center",
